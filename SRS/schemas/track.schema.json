{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Track",
  "type": "object",
  "required": ["id", "name", "lap_time", "length_m"],
  "properties": {
    "id": {"type": "integer"},
    "name": {"type": "string"},
    "lap_time": {"type": "number"},
    "length_m": {"type": "number"},
    "points": {"type": ["array", "null"], "items": {"type": "object"}}
  },
  "additionalProperties": false
}
