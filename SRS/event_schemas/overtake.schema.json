{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "overtake",
  "type": "object",
  "required": ["event_id","schema_version","event_type","race_id","timestamp","payload"],
  "properties": {
    "event_id": {"type":"string"},
    "schema_version": {"type":"string"},
    "event_type": {"const":"overtake"},
    "race_id": {"type":"string"},
    "timestamp": {"type":"string","format":"date-time"},
    "payload": {
      "type": "object",
      "required": ["lap_number","attacker_id","defender_id","success"],
      "properties": {
        "lap_number": {"type":"integer"},
        "attacker_id": {"type":"integer"},
        "defender_id": {"type":"integer"},
        "success": {"type":"boolean"},
        "incident_flag": {"type":"boolean"}
      }
    }
  }
}
