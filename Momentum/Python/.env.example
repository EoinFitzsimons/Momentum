# Momentum Motorsport Simulation - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# NAME GENERATION API CONFIGURATION
# ============================================================================

# NameAPI Service Configuration
# Get your API key from: https://www.nameapi.org/
# Your key (DO NOT commit this to version control):
NAMEAPI_KEY=your-nameapi-key-here

# ParaNames Dataset Configuration  
# Download ParaNames dataset from: https://arxiv.org/abs/2405.09496
# Path to ParaNames TSV file (relative to project root)
PARANAMES_TSV_PATH=data/paranames.tsv

# Name Generation Settings
NAMEAPI_RATE_LIMIT=1.0          # Seconds between API calls
NAMEAPI_MAX_RETRIES=3           # Number of retry attempts
USE_NAMEAPI_PRIMARY=true        # Use NameAPI as primary source
ENABLE_FALLBACK=true            # Enable fallback to ParaNames/hardcoded
NAMEAPI_CACHE_SIZE=1000         # Size of name cache

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# ParaNames Local Database
PARANAMES_DB_PATH=data/paranames.db

# Main simulation database
DATABASE_PATH=database/momentum.db

# ============================================================================
# API CONFIGURATION
# ============================================================================

# FastAPI Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
API_DEBUG=false

# CORS Settings (for Unity integration)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# SIMULATION CONFIGURATION  
# ============================================================================

# Monte Carlo Simulation
MONTE_CARLO_ITERATIONS=1000
RANDOM_SEED=42

# AI Decision Making
AI_DECISION_FREQUENCY=5
STRATEGY_COMPLEXITY=medium

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/momentum.log

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Development mode settings
DEV_MODE=true
ENABLE_DEBUG_ENDPOINTS=true
MOCK_EXTERNAL_APIS=false

# Testing settings
RUN_INTEGRATION_TESTS=false
TEST_DATABASE_PATH=tests/test_momentum.db