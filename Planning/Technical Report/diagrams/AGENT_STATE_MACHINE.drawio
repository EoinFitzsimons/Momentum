<mxfile host="app.diagrams.net" modified="2025-12-05T16:00:00.000Z" agent="5.0" etag="state_machine" version="24.0.0" type="device">
  <diagram id="statemachine" name="Agent Decision State Machine">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- Title -->
        <mxCell id="title" value="Driver Agent Decision State Machine (Per-Lap Cycle)" style="text;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <!-- Start State -->
        <mxCell id="start" value="Lap Start" style="ellipse;fillColor=#90EE90;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="100" height="60" as="geometry"/>
        </mxCell>
        <!-- State 1: Read Environment -->
        <mxCell id="read_env" value="READ ENVIRONMENT&#10;• Current lap progress (%)&#10;• Current speed&#10;• Tire degradation level&#10;• Fuel remaining&#10;• Position in race (relative)&#10;• Gaps: car ahead, car behind&#10;• Weather: rain, temperature&#10;• Track condition: wet/dry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0277BD;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="200" height="130" as="geometry"/>
        </mxCell>
        <!-- State 2: Evaluate Position -->
        <mxCell id="eval_pos" value="EVALUATE POSITION&#10;• Am I leading?&#10;• Am I in points?&#10;• Am I fighting for pos?&#10;• Is pit stop near?&#10;• Tire wear critical?&#10;• Fuel running low?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="200" height="130" as="geometry"/>
        </mxCell>
        <!-- State 3: Risk Assessment -->
        <mxCell id="risk_assess" value="RISK ASSESSMENT&#10;• Gap to car ahead&#10;• DRS window available?&#10;• Fuel for attack?&#10;• Tire grip available?&#10;• Overtaking zone?&#10;• Crash risk if attempt?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#D84315;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="550" y="200" width="200" height="130" as="geometry"/>
        </mxCell>
        <!-- Decision Diamond: Pit Stop -->
        <mxCell id="pit_decision" value="Pit Stop&#nneeded?" style="rhombus;fillColor=#FFE082;strokeColor=#F57F17;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="100" height="80" as="geometry"/>
        </mxCell>
        <!-- Pit Stop Branch -->
        <mxCell id="pit_stop" value="EXECUTE PIT STOP&#10;• Coast to pit lane&#10;• Pit crew services car&#10;• New tires (if available)&#10;• Refuel (if available)&#10;• Resume race" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4C3;strokeColor=#827717;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="1000" y="150" width="180" height="110" as="geometry"/>
        </mxCell>
        <!-- Decision Diamond: Overtake Attempt -->
        <mxCell id="overtake_decision" value="Attempt&#nOvertake?" style="rhombus;fillColor=#FFE082;strokeColor=#F57F17;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="100" height="80" as="geometry"/>
        </mxCell>
        <!-- Overtaking Branch -->
        <mxCell id="overtaking" value="EXECUTE OVERTAKE&#10;• Select overtaking lane&#10;• Increase acceleration (risk)&#10;• Attempt gap closing&#10;• Evaluate success chance&#10;• Commit or abort&#10;• Execute maneuver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#C2185B;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="180" height="130" as="geometry"/>
        </mxCell>
        <!-- Overtake Success Decision -->
        <mxCell id="overtake_success" value="Overtake&#nSuccess?" style="rhombus;fillColor=#FFE082;strokeColor=#F57F17;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="330" width="100" height="80" as="geometry"/>
        </mxCell>
        <!-- Defensive Driving -->
        <mxCell id="defensive" value="DEFENSIVE DRIVING&#10;• Hold position if leading&#10;• Block overtaking lines&#10;• Match car-ahead speed&#10;• Conservative fuel use&#10;• Manage tires for end race" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="550" y="420" width="200" height="110" as="geometry"/>
        </mxCell>
        <!-- Speed Control Decision -->
        <mxCell id="speed_decision" value="Target Speed:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=10;fontStyle=1;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="150" height="60" as="geometry"/>
        </mxCell>
        <!-- Speed Options: Aggressive -->
        <mxCell id="speed_aggressive" value="AGGRESSIVE (100%)\\n• Max speed push\\n• Fuel consumption ↑↑\\n• Tire wear ↑↑\\n• Risk: DNF if pushed too hard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCCC;strokeColor=#C41C3B;strokeWidth=2;fontSize=8;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="160" height="90" as="geometry"/>
        </mxCell>
        <!-- Speed Options: Balanced -->
        <mxCell id="speed_balanced" value="BALANCED (85%)\\n• Cruise pace\\n• Manage fuel/tires\\n• Risk: Lose position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F57F17;strokeWidth=2;fontSize=8;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="160" height="90" as="geometry"/>
        </mxCell>
        <!-- Speed Options: Conservative -->
        <mxCell id="speed_conservative" value="CONSERVATIVE (60%)\\n• Save fuel/tires\\n• Preserve for endurance\\n• Risk: Lose race" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=8;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="50" y="630" width="160" height="90" as="geometry"/>
        </mxCell>
        <!-- Racing Line Calculation -->
        <mxCell id="racing_line" value="UPDATE RACING LINE\\n• Calculate optimal line for track section\\n• Adjust for weather (wet/dry grip)\\n• Account for tire condition\\n• Execute maneuver with physics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#512DA8;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="300" y="550" width="200" height="100" as="geometry"/>
        </mxCell>
        <!-- Mistake Check -->
        <mxCell id="mistake_check" value="DRIVER MISTAKE?\\n• Random chance (driver_error_rate)\\n• Higher chance: wet track, worn tires\\n• Results: lock-up, spin, crash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#D84315;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="550" y="550" width="200" height="100" as="geometry"/>
        </mxCell>
        <!-- Output: Speed & Line -->
        <mxCell id="output_speed" value="OUTPUT: Speed Control\\n• Acceleration (if below target)\\n• Maintain (if on target)\\n• Brake (if above target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0277BD;strokeWidth=2;fontSize=9;align=left;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="800" y="550" width="180" height="100" as="geometry"/>
        </mxCell>
        <!-- Lap Completion Check -->
        <mxCell id="lap_complete" value="Lap\\nComplete?" style="rhombus;fillColor=#FFE082;strokeColor=#F57F17;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="560" width="100" height="80" as="geometry"/>
        </mxCell>
        <!-- End State -->
        <mxCell id="end" value="Next Lap" style="ellipse;fillColor=#90EE90;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="560" width="100" height="60" as="geometry"/>
        </mxCell>
        <!-- Decision Summary Box -->
        <mxCell id="summary" value="Decision Priority (in order of importance):\\n1. Safety: Avoid crash &gt; survive race\\n2. Fuel/Tires: Manage resources or run out &gt; any position gain\\n3. Strategy: Execute pit stops at right time\\n4. Overtaking: Attempt when gap is right and risk is low\\n5. Speed: Maximize within constraints\\n\\nDriver Personality Modifiers:\\n• Aggressive drivers: Higher overtake attempt rate, higher speed targets\\n• Defensive drivers: Lower overtake rate, prefer established positions\\n• Calculating drivers: Better pit timing, fuel management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666;strokeWidth=1;fontSize=9;align=left;spacing=2;;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1">
          <mxGeometry x="50" y="780" width="1300" height="120" as="geometry"/>
        </mxCell>
        <!-- Connections -->
        <mxCell id="conn1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="start" target="read_env" edge="1" />
        <mxCell id="conn2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="read_env" target="eval_pos" edge="1" />
        <mxCell id="conn3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="eval_pos" target="risk_assess" edge="1" />
        <mxCell id="conn4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="risk_assess" target="pit_decision" edge="1" />
        <!-- Pit Stop Yes -->
        <mxCell id="conn5" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="pit_decision" target="pit_stop" edge="1" />
        <!-- Pit Stop No -->
        <mxCell id="conn6" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="pit_decision" target="overtake_decision" edge="1" />
        <!-- Overtake Decision -->
        <mxCell id="conn7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="pit_stop" target="overtake_decision" edge="1" />
        <!-- Overtake Yes -->
        <mxCell id="conn8" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="overtake_decision" target="overtaking" edge="1" />
        <!-- Overtake No -->
        <mxCell id="conn9" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="overtake_decision" target="defensive" edge="1" />
        <!-- Overtake Result -->
        <mxCell id="conn10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="overtaking" target="overtake_success" edge="1" />
        <!-- Speed Control -->
        <mxCell id="conn11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="speed_decision" target="speed_aggressive" edge="1" />
        <mxCell id="conn12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="defensive" target="speed_decision" edge="1" />
        <!-- Racing Line -->
        <mxCell id="conn13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="speed_balanced" target="racing_line" edge="1" />
        <mxCell id="conn14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="racing_line" target="mistake_check" edge="1" />
        <mxCell id="conn15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="mistake_check" target="output_speed" edge="1" />
        <mxCell id="conn16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="output_speed" target="lap_complete" edge="1" />
        <!-- Lap Complete Yes -->
        <mxCell id="conn17" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="lap_complete" target="end" edge="1" />
        <!-- Lap Complete No -->
        <mxCell id="conn18" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;startArrow=none;" parent="1" source="lap_complete" target="read_env" edge="1" />
      </root>
    </mxGraphModel>
  </diagram>
